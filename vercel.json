{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/brand/ou-monitor-mark.svg", "destination": "/brand/ou-monitor-mark-v3.svg", "permanent": true },
    { "source": "/brand/ou-monitor-reverse.svg", "destination": "/brand/ou-monitor-reverse-v3.svg", "permanent": true },
    { "source": "/brand/ou-monitor-character.svg", "destination": "/brand/ou-monitor-character-v3.svg", "permanent": true },
    { "source": "/brand/ou-monitor-bot.svg", "destination": "/brand/ou-monitor-bot-v3.svg", "permanent": true },
    { "source": "/brand/open-shell-mark.svg", "destination": "/brand/ou-monitor-mark-v3.svg", "permanent": true },
    { "source": "/brand/open-shell-reverse.svg", "destination": "/brand/ou-monitor-reverse-v3.svg", "permanent": true },
    { "source": "/brand/shellfolk-builder.svg", "destination": "/brand/ou-monitor-bot-v3.svg", "permanent": true },
    { "source": "/brand/brandkit-open-monitor.png", "destination": "/brand/brandkit-open-monitor-v5.png", "permanent": true },
    { "source": "/brand/brandkit-open-monitor-v3.png", "destination": "/brand/brandkit-open-monitor-v5.png", "permanent": true },
    { "source": "/brand/brandkit-open-monitor-v4.png", "destination": "/brand/brandkit-open-monitor-v5.png", "permanent": true },
    { "source": "/favicon.svg", "destination": "/brand/ou-profile-mark-v1.svg", "permanent": true },
    { "source": "/favicon-v3.svg", "destination": "/brand/ou-profile-mark-v1.svg", "permanent": true },
    { "source": "/apple-touch-icon.png", "destination": "/apple-touch-icon-v1.png", "permanent": true },
    { "source": "/icon-192.png", "destination": "/icon-192-v1.png", "permanent": true },
    { "source": "/icon-512.png", "destination": "/icon-512-v1.png", "permanent": true },
    { "source": "/og.png", "destination": "/og-v6.png", "permanent": true },
    { "source": "/og-v2.png", "destination": "/og-v6.png", "permanent": true },
    { "source": "/og-v3.png", "destination": "/og-v6.png", "permanent": true },
    { "source": "/og-v4.png", "destination": "/og-v6.png", "permanent": true },
    { "source": "/og-v5.png", "destination": "/og-v6.png", "permanent": true },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "openlyuseful.com" }],
      "destination": "https://openlyuseful.org/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.openlyuseful.com" }],
      "destination": "https://openlyuseful.org/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.openlyuseful.org" }],
      "destination": "https://openlyuseful.org/:path*",
      "permanent": true
    }
  ]
}
